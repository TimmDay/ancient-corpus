# Copy to .env (gitignored) and fill in real values. Used by
# ingestion/embed.py, which writes normalized+embedded passages into the
# somnus-data-ingestion app's own Supabase project (the "shared Supabase
# table" architecture decision -- see that repo's SCHEMAS.md).

# console.voyageai.com -> API Keys. Used to embed passage text.
VOYAGE_API_KEY=

# Same Supabase project somnus-data-ingestion uses (Dashboard -> Project
# Settings -> Data API -> Project URL).
SUPABASE_URL=https://[project-ref].supabase.co

# Dashboard -> Project Settings -> Data API -> service_role key. NOT the
# anon key -- embed.py writes rows and needs to bypass RLS to do it.
# Never commit this; never use it client-side anywhere.
SUPABASE_SERVICE_ROLE_KEY=
