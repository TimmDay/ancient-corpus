{
  "name": "ancient-corpus",
  "version": "0.0.0",
  "private": true,
  "description": "A public reading reference of ancient texts, linkable by Work and Locator",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "eslint . --max-warnings 0 && tsc --noEmit",
    "format:check": "prettier --check . --cache",
    "format:write": "prettier --write . --cache",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "prepare": "husky",
    "ingest": "node scripts/ingest.ts",
    "build": "node scripts/build.ts",
    "dev": "node scripts/dev.ts",
    "review": "node scripts/review.ts",
    "index": "node scripts/index.ts",
    "ask": "node scripts/ask.ts",
    "dev:drafts": "node scripts/dev.ts --drafts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "cheerio": "^1.2.0",
    "domhandler": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "fflate": "^0.8.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "eslint --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ]
  }
}
